generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  accounts      Account[]
  sessions      Session[]
  userRole      UserRole?
  emailChange   AccountEmailChange?

  @@index([status])
  @@index([createdAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model Role {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([isSystem])
  @@map("role")
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("permission")
}

model UserRole {
  userId    String   @unique
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@map("user_role")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model Shortlink {
  id                String             @id @default(cuid())
  slug              String             @unique
  destinationUrl    String
  title             String
  description       String?
  mediaType         ShortlinkMediaType
  mediaUrl          String
  posterUrl         String?
  mediaWidth        Int
  mediaHeight       Int
  durationMs        Int?
  displayDurationMs Int                @default(15000)
  mimeType          String?
  contentLength     BigInt?
  status            ShortlinkStatus    @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status])
  @@index([mediaType])
  @@index([createdAt])
  @@map("shortlink")
}

model XAccount {
  id              String         @id @default(cuid())
  xUserId         String         @unique
  username        String
  name            String
  profileImageUrl String?
  status          XAccountStatus @default(CONNECTED)

  // Ads account used by the LIVE Ads creative pipeline.
  // Kept on the connected X account rather than in .env.
  adsAccountId    String?

  connectedAt     DateTime       @default(now())
  lastVerifiedAt  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  credential      XCredential?
  media           XMedia[]
  cards           XCard[]
  posts           XPost[]

  @@index([status])
  @@index([username])
  @@index([adsAccountId])
  @@index([createdAt])
  @@map("x_account")
}

model XCredential {
  id                         String   @id @default(cuid())
  xAccountId                 String   @unique
  accessTokenEncrypted       String
  accessTokenSecretEncrypted String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  xAccount                   XAccount @relation(fields: [xAccountId], references: [id], onDelete: Cascade)

  @@map("x_credential")
}

model XPost {
  id                String        @id @default(cuid())
  xAccountId        String
  type              XPostType     @default(VIDEO)
  text              String?
  mediaUrl          String
  destinationUrl    String?
  mediaWidth        Int
  mediaHeight       Int
  durationMs        Int
  displayDurationMs Int           @default(15000)
  mimeType          String?
  contentLength     BigInt?
  status            XPostStatus   @default(DRAFT)
  provider          XPostProvider @default(MOCK)

  externalDraftId   String?
  externalPostId    String?

  // Compatibility field. Removed only after all consumers migrate
  // to previewUrl/publicUrl.
  externalUrl       String?

  previewUrl        String?
  publicUrl         String?
  draftCreatedAt    DateTime?
  publishedAt       DateTime?

  lastError         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  account           XAccount      @relation(fields: [xAccountId], references: [id], onDelete: Restrict)
  media             XMedia?
  card              XCard?

  @@index([xAccountId])
  @@index([status])
  @@index([provider])
  @@index([createdAt])
  @@map("x_post")
}

model XMedia {
  id                  String                 @id @default(cuid())
  xAccountId          String
  xPostId             String                 @unique
  provider            XPostProvider          @default(MOCK)
  category            XMediaCategory         @default(AMPLIFY_VIDEO)
  uploadStatus        XMediaUploadStatus     @default(PENDING)
  processingStatus    XMediaProcessingStatus @default(PENDING)
  libraryStatus       XMediaLibraryStatus    @default(PENDING)
  lastAppendedSegment Int?

  sourceUrl           String
  xMediaId            String?
  mediaKey            String?
  mimeType            String?
  contentLength       BigInt?
  width               Int?
  height              Int?
  durationMs          Int?
  lastError           String?

  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  account             XAccount               @relation(fields: [xAccountId], references: [id], onDelete: Restrict)
  post                XPost                  @relation(fields: [xPostId], references: [id], onDelete: Cascade)
  card                XCard?

  @@index([xAccountId])
  @@index([provider])
  @@index([uploadStatus])
  @@index([processingStatus])
  @@index([libraryStatus])
  @@index([xMediaId])
  @@index([mediaKey])
  @@map("x_media")
}

model XCard {
  id             String        @id @default(cuid())
  xAccountId     String
  xPostId        String        @unique
  xMediaId       String        @unique
  provider       XPostProvider @default(MOCK)
  type           XCardType     @default(VIDEO_WEBSITE)
  status         XCardStatus   @default(PENDING)

  name           String
  title          String
  destinationUrl String

  xCardId        String?
  cardUri        String?
  lastError      String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  account        XAccount      @relation(fields: [xAccountId], references: [id], onDelete: Restrict)
  post           XPost         @relation(fields: [xPostId], references: [id], onDelete: Cascade)
  media          XMedia        @relation(fields: [xMediaId], references: [id], onDelete: Cascade)

  @@index([xAccountId])
  @@index([provider])
  @@index([status])
  @@index([xCardId])
  @@index([cardUri])
  @@map("x_card")
}

model XOAuthTransaction {
  id                        String   @id @default(cuid())
  oauthToken                String   @unique
  oauthTokenSecretEncrypted String
  expiresAt                 DateTime
  consumedAt                DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([expiresAt])
  @@map("x_oauth_transaction")
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  actorName     String?
  actorEmail    String?
  action        String
  resource      String
  resourceId    String?
  requestId     String?
  ipAddress     String?
  userAgent     String?
  changedFields String[]
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([actorUserId])
  @@index([resource, resourceId])
  @@index([action])
  @@index([requestId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AccountEmailChange {
  id        String   @id @default(cuid())
  userId    String   @unique
  newEmail  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([newEmail])
  @@index([expiresAt])
  @@map("account_email_change")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ShortlinkMediaType {
  IMAGE
  VIDEO
}

enum ShortlinkStatus {
  ACTIVE
  INACTIVE
}

enum XAccountStatus {
  CONNECTED
  REVOKED
  ERROR
}

enum XPostType {
  VIDEO
}

enum XPostStatus {
  DRAFT
  PROCESSING
  READY
  PUBLISHED
  FAILED
}

enum XPostProvider {
  MOCK
  LIVE
}

enum XMediaCategory {
  AMPLIFY_VIDEO
}

enum XMediaUploadStatus {
  PENDING
  INITIALIZED
  APPENDED
  FINALIZED
}

enum XMediaProcessingStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

enum XMediaLibraryStatus {
  PENDING
  REGISTERED
  FAILED
}

enum XCardType {
  VIDEO_WEBSITE
}

enum XCardStatus {
  PENDING
  CREATED
  FAILED
}