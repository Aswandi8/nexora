# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nexora

# Better Auth / Core
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Trusted Console origin
NEXORA_CONSOLE_URL=http://localhost:3001

# Initial protected administrator
NEXORA_ADMIN_NAME=Nexora Admin
NEXORA_ADMIN_EMAIL=admin@example.com
NEXORA_ADMIN_PASSWORD=replace-with-a-strong-password

# Remote media inspection
SHORTLINK_MEDIA_MAX_BYTES=262144000
SHORTLINK_MEDIA_TIMEOUT_MS=30000